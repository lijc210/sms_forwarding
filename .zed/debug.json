// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
    {
        "adapter": "Debugpy",
        "label": "Debug Current Python File", // 任务显示名称，在命令面板中看到的标签
        "request": "launch",
        "python": ".venv/bin/python", // 执行的命令：使用项目虚拟环境中的Python解释器运行当前文件
        "program": "${ZED_FILE}",
        "args": [], // 额外参数数组，这里为空表示不需要额外参数
        "cwd": "${ZED_WORKTREE_ROOT}",
        "env": {
            "PYTHONPATH": "${ZED_WORKTREE_ROOT}",
        },
        "console": "integratedTerminal",
        "stopOnEntry": false,
        "showReturnValue": true,
        "redirectOutput": true,
    },
]
